{
  "name": "crm-silmer",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.19.0",
  "engines": {
    "node": "24.20.0",
    "npm": "11.19.0"
  },
  "workspaces": [
    "apps/*",
    "modules/*"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "check:design-tokens": "node scripts/check-design-tokens.mjs",
    "db:migrate": "npm run migrate --workspace @crm-silmer/database --",
    "dev": "node scripts/dev.mjs",
    "dev:down": "docker compose -f docker-compose.dev.yml down",
    "format": "prettier --write package.json \"apps/**/*.{html,css,js,json,vue}\" \"modules/**/*.{js,json}\" \"docs/phase0/**/*.{json,md}\" \"docs/adr/**/*.md\" \"ops/**/*.{json,md}\" \"schemas/**/*.json\" \"scripts/**/*.mjs\" \"test/**/*.js\" \".github/**/*.{md,yml,yaml}\" eslint.config.js jsconfig.json playwright.config.js .prettierrc.json",
    "format:check": "prettier --check package.json \"apps/**/*.{html,css,js,json,vue}\" \"modules/**/*.{js,json}\" \"docs/phase0/**/*.{json,md}\" \"docs/adr/**/*.md\" \"ops/**/*.{json,md}\" \"schemas/**/*.json\" \"scripts/**/*.mjs\" \"test/**/*.js\" \".github/**/*.{md,yml,yaml}\" eslint.config.js jsconfig.json playwright.config.js .prettierrc.json",
    "lint": "eslint apps modules scripts test eslint.config.js",
    "preview": "node scripts/serve-edge.mjs",
    "recovery:plan": "node scripts/recovery-mock.mjs --plan",
    "smoke:r2:live": "node scripts/r2-live-smoke.mjs",
    "smoke:meta:sandbox": "node scripts/meta-sandbox-smoke.mjs",
    "smoke:gemini:privacy": "node scripts/gemini-privacy-smoke.mjs",
    "smoke:observability:live": "node scripts/observability-live-probe.mjs --baseline",
    "drill:observability:api": "node scripts/observability-live-probe.mjs --watch-api-drill",
    "generate:ficha-pdf-review": "node scripts/ficha-pdf-review.mjs --generate",
    "test": "node --test test/*.test.js",
    "test:database": "node --test test/database.test.js test/migrations.test.js",
    "test:database:live": "node --test test/migrations-live.test.js",
    "test:recovery:mocks": "node --test test/topology-recovery.test.js",
    "test:r2": "node --test test/r2-live-smoke.test.js",
    "test:external-spikes": "node --test test/external-spikes.test.js",
    "test:observability": "node --test test/observability.test.js test/observability-live-probe.test.js",
    "test:gemini:privacy": "node --test test/gemini-privacy-smoke.test.js",
    "test:identity:live": "node --test --test-concurrency=1 test/migrations-live.test.js test/phase1-schema-live.test.js test/identity-postgres-live.test.js test/postgres-audit-live.test.js test/postgres-idempotency-live.test.js test/identity-api-live.test.js test/configuration-catalog-postgres-live.test.js",
    "test:webhook:live": "node --test --test-concurrency=1 test/postgres-webhook-inbox-live.test.js",
    "test:worker:live": "node --test --test-concurrency=1 test/postgres-job-queue-live.test.js",
    "test:configuration-catalog:live": "node --test --test-concurrency=1 test/configuration-catalog-postgres-live.test.js",
    "test:deal-conversion:live": "node --test --test-concurrency=1 test/deal-conversion-postgres-live.test.js",
    "test:deal:live": "node --test --test-concurrency=1 test/deal-conversion-postgres-live.test.js test/deal-transitions-postgres-live.test.js test/qualification-postgres-live.test.js test/work-management-postgres-live.test.js test/deal-read-postgres-live.test.js",
    "test:media-retention": "node --test test/media-retention-policy.test.js test/transient-media-retention.test.js",
    "test:phase0-decisions": "node --test test/phase0-decisions.test.js",
    "test:phase1-schema:live": "node --test test/phase1-schema-live.test.js",
    "test:security-catalog": "node --test test/security-catalog.test.js",
    "test:ficha-pdf-review": "node --test test/ficha-pdf-review.test.js",
    "test:e2e": "playwright test",
    "typecheck": "tsc --project jsconfig.json",
    "validate:topology": "node scripts/validate-topology.mjs && node scripts/recovery-mock.mjs --check",
    "validate:r2": "node scripts/validate-r2.mjs",
    "validate:external-spikes": "node scripts/validate-external-spikes.mjs",
    "validate:media-retention": "node scripts/validate-media-retention.mjs",
    "validate:observability": "node scripts/validate-observability.mjs",
    "validate:phase0-decisions": "node scripts/validate-phase0-decisions.mjs",
    "validate:security-catalog": "node scripts/validate-security-catalog.mjs",
    "validate:ficha-pdf-review": "node scripts/ficha-pdf-review.mjs --validate",
    "validate": "npm run format:check && npm run typecheck && npm run lint && npm run check:boundaries && npm run check:design-tokens && npm run validate:topology && npm run validate:r2 && npm run validate:external-spikes && npm run validate:media-retention && npm run validate:security-catalog && npm run validate:ficha-pdf-review && npm run validate:phase0-decisions && npm run validate:observability && npm test && npm run build"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.62.1",
    "@types/node": "24.13.3",
    "@types/punycode": "2.1.4",
    "@vitejs/plugin-vue": "6.0.8",
    "@fontsource/poppins": "5.3.0",
    "eslint": "10.9.1",
    "eslint-plugin-vue": "10.11.0",
    "prettier": "3.9.6",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vue": "3.5.42",
    "vue-router": "4.6.4"
  }
}
