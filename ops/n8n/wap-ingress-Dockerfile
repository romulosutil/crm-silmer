# WAP-E01. A build-only wrapper; all personal ingress remains default off.
FROM n8nio/n8n:2.38.7@sha256:a8c95f75c6fdf65f5f2b7a7b354744eaa1c62bb911b5c00af6499c3f38e4cd32
USER root
COPY wap-ingress-runtime.cjs /opt/silmer/wap-ingress-runtime.cjs
COPY wap-ingress-patch.mjs /opt/silmer/wap-ingress-patch.mjs
RUN node /opt/silmer/wap-ingress-patch.mjs /usr/local/lib/node_modules/n8n
USER node
