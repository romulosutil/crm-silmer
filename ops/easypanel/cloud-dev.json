{
  "schemaVersion": 1,
  "task": "OPS-1",
  "purpose": "cloud-development-only",
  "project": "espectro-mvp",
  "source": {
    "repository": "romulosutil/crm-silmer",
    "branch": "dev",
    "autoDeploy": true,
    "deploymentRule": "push-to-dev"
  },
  "services": [
    {
      "name": "silmer-edge-web",
      "kind": "app",
      "dockerfile": "docker/edge-web.cloud-dev.Dockerfile",
      "public": true,
      "port": 8080,
      "healthPath": "/healthz"
    },
    {
      "name": "silmer-api",
      "kind": "app",
      "dockerfile": "docker/runtime.Dockerfile",
      "command": "node apps/api/src/server.js",
      "public": false,
      "port": 3000,
      "healthPath": "/api/health/ready"
    },
    {
      "name": "silmer-worker",
      "kind": "app",
      "dockerfile": "docker/runtime.Dockerfile",
      "command": "node apps/worker/src/worker.js",
      "public": false
    },
    {
      "name": "schedule-n8n",
      "kind": "external-n8n",
      "managedBy": "existing-easypanel-service",
      "access": "public-https-only",
      "configuration": {
        "panelBaseUrl": "operator-supplied-cloud-dev-edge-url",
        "commandWebhookUrl": "operator-supplied-schedule-n8n-command-webhook-url"
      }
    }
  ],
  "security": {
    "crmApiPublic": false,
    "crmDatabasePublic": false,
    "scheduleN8nManagedOutsideProject": true,
    "n8nCrmDatabaseAccess": false,
    "n8nUsesCrmPublicApi": true,
    "secretsCommitted": false
  }
}
