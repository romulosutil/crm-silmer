{
  "name": "crm-silmer",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.9.0",
  "engines": {
    "node": "24.14.0",
    "npm": "11.9.0"
  },
  "workspaces": [
    "apps/*",
    "modules/*"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "format": "prettier --write package.json \"apps/**/*.{html,css,js,json}\" \"modules/**/*.{js,json}\" \"scripts/**/*.mjs\" \"test/**/*.js\" eslint.config.js jsconfig.json .prettierrc.json",
    "format:check": "prettier --check package.json \"apps/**/*.{html,css,js,json}\" \"modules/**/*.{js,json}\" \"scripts/**/*.mjs\" \"test/**/*.js\" eslint.config.js jsconfig.json .prettierrc.json",
    "lint": "eslint apps modules scripts test eslint.config.js",
    "test": "node --test",
    "typecheck": "tsc --project jsconfig.json",
    "validate": "npm run format:check && npm run typecheck && npm run lint && npm run check:boundaries && npm test && npm run build"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "@types/punycode": "2.1.4",
    "eslint": "10.9.1",
    "prettier": "3.9.6",
    "typescript": "7.0.2"
  }
}
