# syntax=docker/dockerfile:1.7
# EVOL-01. Official Evolution v2.3.7 OCI index, verified 2026-10-29.
FROM node:24.22.1-alpine3.23@sha256:0468540aa58203ff9e40c2aab3907c52644ab818af6176b1c70a026137dc92a2 AS node_runtime
FROM evoapicloud/evolution-api:v2.3.7@sha256:1bd8afc4a6cf48822e6cf02469aeae7bd35a12a6b616eacd1291926307f4d339
COPY --from=node_runtime /usr/local/bin/node /usr/local/bin/node
WORKDIR /evolution
ENV TZ=UTC NODE_VERSION=24.22.1
RUN node -e 'if (process.version !== "v24.22.1" || !require("node:fs").readFileSync("/etc/alpine-release", "utf8").startsWith("3.23.")) process.exit(1); Promise.all([import("baileys"), import("sharp"), import("@prisma/client")]).then(() => process.stdout.write("EVOLUTION_RUNTIME_COMPATIBLE\n")).catch(() => process.exit(1));'
COPY <<'SILMER_PRIVACY_EOF' /evolution/silmer-privacy.cjs
'use strict';

// EVOL-01 / ORC-08 / MSG-01..04. No credentials or message content in logs.
const Module = require('node:module');

const WEBHOOK_HEADER = 'X-Silmer-Evolution-Token';
const WEBHOOK_EVENTS = new Set([
  'messages.upsert',
  'messages.update',
  'connection.update',
]);

function fail(code) {
  const error = new Error(code);
  error.code = code;
  throw error;
}

function validateEnvironment(env) {
  for (const key of [
    'AUTHENTICATION_API_KEY',
    'SILMER_EVOLUTION_WEBHOOK_TOKEN',
  ]) {
    if (
      !env[key] ||
      env[key].length < 32 ||
      /CHANGE|REPLACE|EXAMPLE/i.test(env[key])
    ) {
      fail('EVOLUTION_SECRET_CONFIGURATION_INVALID');
    }
  }
  if (env.AUTHENTICATION_API_KEY === env.SILMER_EVOLUTION_WEBHOOK_TOKEN) {
    fail('EVOLUTION_SECRETS_MUST_DIFFER');
  }
  let database;
  let webhook;
  try {
    database = new URL(env.DATABASE_CONNECTION_URI);
    webhook = new URL(env.SILMER_EVOLUTION_WEBHOOK_URL);
  } catch {
    fail('EVOLUTION_URL_CONFIGURATION_INVALID');
  }
  if (
    database.protocol !== 'postgresql:' ||
    database.pathname !== '/silmer_evolution' ||
    decodeURIComponent(database.username) !== 'silmer_evolution' ||
    !database.password
  ) {
    fail('EVOLUTION_DATABASE_MUST_BE_ISOLATED');
  }
  if (
    webhook.protocol !== 'https:' ||
    webhook.username ||
    webhook.password ||
    webhook.search ||
    webhook.hash ||
    !webhook.pathname.startsWith('/webhook/')
  ) {
    fail('EVOLUTION_WEBHOOK_CONFIGURATION_INVALID');
  }
  const required = {
    DATABASE_PROVIDER: 'postgresql',
    CACHE_REDIS_ENABLED: 'false',
    CACHE_REDIS_SAVE_INSTANCES: 'false',
    CACHE_LOCAL_ENABLED: 'true',
    TELEMETRY_ENABLED: 'false',
    AUTHENTICATION_EXPOSE_IN_FETCH_INSTANCES: 'false',
    WEBHOOK_GLOBAL_ENABLED: 'false',
    PROMETHEUS_METRICS: 'false',
    WEBSOCKET_ENABLED: 'false',
    LOG_LEVEL: 'ERROR',
    LOG_BAILEYS: 'fatal',
    DOCKER_ENV: 'true',
    TZ: 'UTC',
    DATABASE_SAVE_DATA_NEW_MESSAGE: 'true',
    // WAP-E12: every Evolution 2.3.7 egress integration is pinned off. They
    // must be present: an absent flag would leave the decision to upstream.
    RABBITMQ_ENABLED: 'false',
    SQS_ENABLED: 'false',
    KAFKA_ENABLED: 'false',
    NATS_ENABLED: 'false',
    PUSHER_ENABLED: 'false',
    S3_ENABLED: 'false',
    CHATWOOT_ENABLED: 'false',
    TYPEBOT_ENABLED: 'false',
    OPENAI_ENABLED: 'false',
    DIFY_ENABLED: 'false',
    N8N_ENABLED: 'false',
    EVOAI_ENABLED: 'false',
    FLOWISE_ENABLED: 'false',
    PROVIDER_ENABLED: 'false',
  };
  for (const [key, value] of Object.entries(required)) {
    if (env[key] !== value) fail('EVOLUTION_PROFILE_CONFIGURATION_INVALID');
  }
  if (env.SENTRY_DSN) fail('EVOLUTION_PROFILE_CONFIGURATION_INVALID');
  if (!/^[A-Za-z0-9_-]{1,64}$/.test(env.SILMER_EVOLUTION_INSTANCE || '')) {
    fail('EVOLUTION_INSTANCE_CONFIGURATION_INVALID');
  }
  let personal;
  if (env.SILMER_WAP_CONTROL_ENABLED === 'true') {
    const { configuration } = require('./wap-control-runtime.cjs');
    personal = configuration(env);
  }
  return {
    webhookUrl: webhook.href,
    webhookToken: env.SILMER_EVOLUTION_WEBHOOK_TOKEN,
    ...(personal
      ? {
          personalWebhookUrl: personal.webhook,
          personalInstances: personal.instances,
        }
      : {}),
  };
}

function protectWebhookRequest(config, profile) {
  const data = config.data;
  // Evolution uses Axios for other integrations too. Only intercept event envelopes.
  if (
    !data ||
    typeof data !== 'object' ||
    typeof data.event !== 'string' ||
    !data.instance
  ) {
    return config;
  }
  let destination;
  try {
    destination = new URL(config.url || '', config.baseURL).href;
  } catch {
    fail('EVOLUTION_WEBHOOK_DESTINATION_REJECTED');
  }
  const personal = profile.personalInstances?.includes(data.instance) === true;
  if (
    destination !==
      (personal ? profile.personalWebhookUrl : profile.webhookUrl) ||
    !WEBHOOK_EVENTS.has(data.event) ||
    // WAP-E12: personal lifecycle, inbound, echo and receipt events all need
    // the socket-bound source and generation proof (wap-generation-runtime).
    (personal &&
      (!data.source || !config.headers?.['X-Silmer-Wap-Generation-Token']))
  ) {
    fail('EVOLUTION_WEBHOOK_DESTINATION_REJECTED');
  }
  // Upstream includes its instance API key in every webhook payload.
  const safeData = { ...data };
  delete safeData.apikey;
  delete safeData.api_key;
  config.data = safeData;
  config.maxRedirects = 0;
  config.headers = {
    ...config.headers,
    [WEBHOOK_HEADER]: profile.webhookToken,
  };
  return config;
}

function protectAxios(axios, profile) {
  if (
    !axios ||
    typeof axios.create !== 'function' ||
    axios.__silmerWebhookProtected
  )
    return axios;
  const create = axios.create.bind(axios);
  axios.create = (...args) => {
    const client = create(...args);
    client.interceptors.request.use((config) =>
      protectWebhookRequest(config, profile),
    );
    return client;
  };
  Object.defineProperty(axios, '__silmerWebhookProtected', { value: true });
  return axios;
}

function protectStream(stream, tag) {
  const write = stream.write.bind(stream);
  stream.write = (_chunk, encoding, callback) => {
    const done = typeof encoding === 'function' ? encoding : callback;
    // Do not inspect or echo the original chunk: it can contain QR, token or PII.
    return write(`${tag}\n`, done);
  };
}

function installRuntimeProtection(env = process.env) {
  const profile = validateEnvironment(env);
  const safeOutput = process.stdout.write.bind(process.stdout);
  protectStream(process.stdout, 'EVOLUTION_RUNTIME_OUTPUT_REDACTED');
  protectStream(process.stderr, 'EVOLUTION_RUNTIME_ERROR_REDACTED');
  const load = Module._load;
  const expressWrappers = new WeakMap();
  Module._load = function loadProtected(request, parent, isMain) {
    const result = load.call(this, request, parent, isMain);
    if (request === 'axios') protectAxios(result, profile);
    if (request === 'express') {
      if (!expressWrappers.has(result)) {
        const { protectExpress } = require('./wap-control-runtime.cjs');
        expressWrappers.set(
          result,
          protectExpress(result, {
            env,
            generationRuntime: require('./silmer-wap-generation.cjs'),
          }),
        );
      }
      return expressWrappers.get(result);
    }
    return result;
  };
  const { PrismaClient } = require('@prisma/client');
  const {
    scheduleRetention,
    retentionInstances,
  } = require('./silmer-retention.cjs');
  const prisma = new PrismaClient({ log: [] });
  // WAP-E12: same seven-day policy for the general and personal instances.
  scheduleRetention(prisma, {
    instances: retentionInstances(env),
    report: (code) => safeOutput(`${code}\n`),
  });
}

module.exports = {
  validateEnvironment,
  protectWebhookRequest,
  protectAxios,
  protectStream,
  installRuntimeProtection,
};

if (require.main === module) {
  try {
    validateEnvironment(process.env);
    process.stdout.write('EVOLUTION_PROFILE_VALIDATED\n');
  } catch {
    process.stderr.write('EVOLUTION_PROFILE_INVALID\n');
    process.exitCode = 1;
  }
} else if (
  process.env.SILMER_EVOLUTION_RUNTIME === 'true' &&
  /(?:^|[\\/])dist[\\/]main(?:\.js)?$/.test(process.argv[1] || '')
) {
  installRuntimeProtection();
}

SILMER_PRIVACY_EOF
COPY <<'SILMER_RETENTION_EOF' /evolution/silmer-retention.cjs
'use strict';

const RETENTION_SECONDS = 7 * 24 * 60 * 60;
const RETENTION_INTERVAL_MS = 60 * 60 * 1000;
const ID = /^[A-Za-z0-9_-]{1,64}$/;

function invalid() {
  throw new Error('EVOLUTION_RETENTION_CONFIGURATION_INVALID');
}

// WAP-E12: the general transport plus every personal instance the generation
// allowlist names. Listed instances stay covered after a rollback to
// generation off, so their rows still age out. Mirrors the generation runtime:
// literal flag, IDs only, no duplicates, enabled requires a list.
function retentionInstances(env) {
  const flag = env.SILMER_WAP_GENERATION_ENABLED;
  const raw = env.SILMER_WAP_GENERATION_INSTANCES ?? '';
  const personal = raw === '' ? [] : raw.split(',');
  const instances = [env.SILMER_EVOLUTION_INSTANCE, ...personal];
  if (
    (flag !== undefined && !['true', 'false'].includes(flag)) ||
    (flag === 'true' && !personal.length) ||
    instances.some((name) => typeof name !== 'string' || !ID.test(name)) ||
    new Set(instances).size !== instances.length
  )
    invalid();
  return instances;
}

async function purgeExpiredMessages(prisma, { instances, now = Date.now() }) {
  if (
    !Array.isArray(instances) ||
    !instances.length ||
    instances.some((name) => typeof name !== 'string' || !ID.test(name)) ||
    new Set(instances).size !== instances.length ||
    !Number.isFinite(now) ||
    now <= RETENTION_SECONDS * 1000
  )
    invalid();
  // Only the dedicated transport's Message rows are eligible. Official schema
  // cascades MessageUpdate and Media; Instance/Session are never mutation targets.
  // One parameterised Prisma statement; names are bound values, never SQL text.
  return prisma.message.deleteMany({
    where: {
      Instance: { is: { name: { in: [...instances] } } },
      messageTimestamp: { lt: Math.floor(now / 1000) - RETENTION_SECONDS },
    },
  });
}

function scheduleRetention(
  prisma,
  { instances, report, schedule = setInterval },
) {
  let running = false;
  const tick = async () => {
    if (running) return;
    running = true;
    try {
      await purgeExpiredMessages(prisma, { instances });
      report('EVOLUTION_RETENTION_COMPLETED');
    } catch {
      report('EVOLUTION_RETENTION_FAILED');
    } finally {
      running = false;
    }
  };
  const timer = schedule(tick, RETENTION_INTERVAL_MS);
  timer.unref?.();
  return { timer, tick };
}

module.exports = {
  RETENTION_SECONDS,
  RETENTION_INTERVAL_MS,
  retentionInstances,
  purgeExpiredMessages,
  scheduleRetention,
};

if (require.main === module) {
  (async () => {
    const { PrismaClient } = require('@prisma/client');
    const prisma = new PrismaClient({ log: [] });
    try {
      await purgeExpiredMessages(prisma, {
        instances: retentionInstances(process.env),
      });
      process.stdout.write('EVOLUTION_RETENTION_COMPLETED\n');
    } catch {
      process.stderr.write('EVOLUTION_RETENTION_FAILED\n');
      process.exitCode = 1;
    } finally {
      await prisma.$disconnect();
    }
  })().catch(() => {
    process.stderr.write('EVOLUTION_RETENTION_FAILED\n');
    process.exitCode = 1;
  });
}

SILMER_RETENTION_EOF
COPY <<'SILMER_WAP_GENERATION_RUNTIME_EOF' /evolution/silmer-wap-generation.cjs
'use strict';

// WAP-E01: source identity is attached once to the socket, before async queueing.
// No endpoint, disk store, workflow staticData or lookup of the current generation.
const { AsyncLocalStorage } = require('node:async_hooks');
const { createHash } = require('node:crypto');

const GENERATION_HEADER = 'X-Silmer-Wap-Generation-Token';
const ID = /^[A-Za-z0-9_-]{1,64}$/;
const SOURCE_KEYS = ['accountId', 'bindingId', 'generation', 'lineId'];
const MESSAGE_EVENTS = new Set(['messages.upsert', 'messages.update']);
const EVENTS = new Set(['connection.update', ...MESSAGE_EVENTS]);
// Mirrors validateEvolutionEvent: SERVER_ACK is represented by the HTTP result.
const RECEIPTS = new Set(['ERROR', 'DELIVERY_ACK', 'READ', 'PLAYED']);
const UNUSED_CHAT = /@(?:g\.us|broadcast|newsletter)$/;

function reject(code) {
  throw new Error(code);
}

function plainObject(value) {
  return value !== null && typeof value === 'object' && !Array.isArray(value);
}

// WAP-E12: same top-level allowlist as the n8n ingress eventBody. The upstream
// apikey and any `extra` keys never leave the process. Chats the CRM never
// uses (groups, broadcast/status, newsletters) and receipts it ignores are
// refused here so their content does not transit n8n.
function messageEnvelope(context, original) {
  const data = original.data;
  const key = original.event === 'messages.update' ? data : data?.key;
  if (
    !plainObject(data) ||
    !plainObject(key) ||
    typeof original.date_time !== 'string' ||
    typeof original.sender !== 'string' ||
    !['destination', 'server_url'].every(
      (field) =>
        original[field] === undefined ||
        (typeof original[field] === 'string' && original[field].length <= 1024),
    ) ||
    key.participant ||
    key.participantAlt ||
    UNUSED_CHAT.test(String(key.remoteJid)) ||
    (original.event === 'messages.update' &&
      (key.fromMe !== true || !RECEIPTS.has(key.status)))
  )
    reject('WAP_GENERATION_ENVELOPE_DENIED');
  return {
    event: original.event,
    instance: context.instance,
    source: context.source,
    data,
    destination: original.destination,
    date_time: original.date_time,
    sender: original.sender,
    server_url: original.server_url,
  };
}

function immutableSource(value) {
  if (
    !value ||
    typeof value !== 'object' ||
    Array.isArray(value) ||
    Object.keys(value).sort().join(',') !== SOURCE_KEYS.join(',') ||
    !['bindingId', 'lineId', 'accountId'].every(
      (key) => typeof value[key] === 'string' && ID.test(value[key]),
    ) ||
    !Number.isSafeInteger(value.generation) ||
    value.generation < 1
  )
    reject('WAP_GENERATION_SOURCE_INVALID');
  return Object.freeze({
    bindingId: value.bindingId,
    lineId: value.lineId,
    accountId: value.accountId,
    generation: value.generation,
  });
}

// Snapshot only: Baileys still needs the live code to finish the handshake.
// Session keys (including advSecretKey and Buffer/Uint8Array keys) are preserved.
function persistableCredentials(credentials) {
  if (
    !credentials ||
    typeof credentials !== 'object' ||
    Array.isArray(credentials)
  )
    reject('WAP_CREDENTIALS_SNAPSHOT_INVALID');
  const snapshot = { ...credentials };
  delete snapshot.pairingCode;
  return snapshot;
}

function createGenerationRuntime(options = {}) {
  const enabled = options.enabled ?? false;
  const instances = options.instances ?? [];
  if (
    typeof enabled !== 'boolean' ||
    !Array.isArray(instances) ||
    instances.some(
      (instance) => typeof instance !== 'string' || !ID.test(instance),
    ) ||
    new Set(instances).size !== instances.length ||
    (enabled && !instances.length)
  )
    reject('WAP_GENERATION_CONFIG_INVALID');
  const allowlist = new Set(instances);
  const local = new AsyncLocalStorage();
  const pending = new Map();
  const sockets = new WeakMap();
  const secrets = new WeakMap();
  const latest = new Map();
  const currentBindings = new Map();
  const capturedByInstance = new Map();
  const usedBindings = new Set();
  const usedTokenHashes = new Set();
  const selected = (instance) => allowlist.has(instance);
  const requireSelected = (instance) => {
    if (!enabled) reject('WAP_GENERATION_DISABLED');
    if (!selected(instance)) reject('WAP_GENERATION_INSTANCE_DENIED');
  };
  const requireContext = (context) => {
    if (!context || !secrets.has(context))
      reject('WAP_GENERATION_CONTEXT_INVALID');
  };

  return Object.freeze({
    // Trusted in-process control hook. E01 exercises it only from the rehearsal.
    // No HTTP route, mutation from provider payload, or implicit reconnect binding.
    bindNextSocket(instance, source, token) {
      requireSelected(instance);
      const snapshot = immutableSource(source);
      if (typeof token !== 'string' || !/^[A-Za-z0-9_-]{32,128}$/.test(token))
        reject('WAP_GENERATION_TOKEN_INVALID');
      if (pending.has(instance)) reject('WAP_GENERATION_BINDING_PENDING');
      const previous = latest.get(instance);
      if (
        previous &&
        (snapshot.lineId !== previous.lineId ||
          snapshot.accountId !== previous.accountId ||
          snapshot.generation <= previous.generation)
      )
        reject('WAP_GENERATION_BINDING_STALE');
      const tokenHash = createHash('sha256').update(token).digest('hex');
      if (
        usedBindings.has(snapshot.bindingId) ||
        usedTokenHashes.has(tokenHash)
      )
        reject('WAP_GENERATION_BINDING_REUSED');
      const context = Object.freeze({ instance, source: snapshot });
      secrets.set(context, token);
      pending.set(instance, context);
      latest.set(instance, snapshot);
      currentBindings.set(instance, context);
      usedBindings.add(snapshot.bindingId);
      usedTokenHashes.add(tokenHash);
    },
    // The control adapter may renew a challenge only after CRM reconciliation.
    // Reasserting the exact binding does not replace the captured socket source.
    ensureBinding(instance, source, token) {
      requireSelected(instance);
      const snapshot = immutableSource(source);
      const current = currentBindings.get(instance);
      if (
        current &&
        Object.keys(snapshot).every(
          (key) => current.source[key] === snapshot[key],
        )
      ) {
        if (
          typeof token !== 'string' ||
          createHash('sha256').update(token).digest('hex') !==
            createHash('sha256').update(secrets.get(current)).digest('hex')
        )
          reject('WAP_GENERATION_BINDING_REUSED');
        return Object.freeze({ duplicate: true });
      }
      this.bindNextSocket(instance, snapshot, token);
      return Object.freeze({ duplicate: false });
    },
    // Connection state alone cannot prove which socket generation is online.
    // A pending binding never passes; process restart intentionally loses proof.
    bindingMatchesSocket(instance, source, token) {
      requireSelected(instance);
      const snapshot = immutableSource(source);
      const captured = capturedByInstance.get(instance);
      return Boolean(
        captured &&
        typeof token === 'string' &&
        Object.keys(snapshot).every(
          (key) => captured.source[key] === snapshot[key],
        ) &&
        createHash('sha256').update(token).digest('hex') ===
          createHash('sha256').update(secrets.get(captured)).digest('hex'),
      );
    },
    captureSocket(instance, socket) {
      const existing =
        socket && typeof socket === 'object' ? sockets.get(socket) : null;
      if (existing && existing.instance !== instance)
        reject('WAP_GENERATION_SOCKET_MISMATCH');
      if (!selected(instance)) return null;
      requireSelected(instance);
      if (!socket || typeof socket !== 'object')
        reject('WAP_GENERATION_SOCKET_REQUIRED');
      if (existing) {
        return existing;
      }
      // A native reconnect has already allocated a different socket. Failure to
      // capture it must not leave the previous socket as proof of connection.
      // Existing callbacks still retain their immutable context in sockets/local.
      capturedByInstance.delete(instance);
      const context = pending.get(instance);
      if (!context) reject('WAP_GENERATION_BINDING_REQUIRED');
      pending.delete(instance);
      sockets.set(socket, context);
      capturedByInstance.set(instance, context);
      return context;
    },
    wrap(context, callback) {
      if (context === null) return callback;
      requireContext(context);
      if (typeof callback !== 'function')
        reject('WAP_GENERATION_CALLBACK_REQUIRED');
      return function sourceBoundCallback(...args) {
        return local.run(context, () => callback.apply(this, args));
      };
    },
    current(instance, event) {
      const context = local.getStore();
      if (!selected(instance)) {
        if (context) reject('WAP_GENERATION_INSTANCE_MISMATCH');
        return null;
      }
      requireSelected(instance);
      requireContext(context);
      if (context.instance !== instance)
        reject('WAP_GENERATION_INSTANCE_MISMATCH');
      // WAP-E12: lifecycle plus inbound/echo/receipt events. Default deny the rest.
      if (!EVENTS.has(event)) reject('WAP_GENERATION_EVENT_DENIED');
      return context;
    },
    headers(context, original) {
      if (context === null) return original;
      requireContext(context);
      const result = { ...original };
      for (const key of Object.keys(result))
        if (key.toLowerCase() === GENERATION_HEADER.toLowerCase())
          delete result[key];
      result[GENERATION_HEADER] = secrets.get(context);
      return result;
    },
    envelope(context, original) {
      if (context === null) return original;
      requireContext(context);
      if (
        original?.instance === context.instance &&
        MESSAGE_EVENTS.has(original?.event)
      )
        return messageEnvelope(context, original);
      if (
        original?.instance !== context.instance ||
        original?.event !== 'connection.update' ||
        !['connecting', 'close', 'open'].includes(original?.data?.state)
      )
        reject('WAP_GENERATION_ENVELOPE_DENIED');
      return {
        event: original.event,
        instance: context.instance,
        source: context.source,
        data: { state: original.data.state },
      };
    },
  });
}

function fromEnvironment(env) {
  if (
    env.SILMER_WAP_GENERATION_ENABLED !== undefined &&
    !['true', 'false'].includes(env.SILMER_WAP_GENERATION_ENABLED)
  )
    reject('WAP_GENERATION_CONFIG_INVALID');
  const raw = env.SILMER_WAP_GENERATION_INSTANCES ?? '';
  return createGenerationRuntime({
    enabled: env.SILMER_WAP_GENERATION_ENABLED === 'true',
    instances: raw === '' ? [] : raw.split(','),
  });
}

module.exports = {
  ...fromEnvironment(process.env),
  createGenerationRuntime,
  immutableSource,
  persistableCredentials,
  fromEnvironment,
  GENERATION_HEADER,
};

SILMER_WAP_GENERATION_RUNTIME_EOF
COPY <<'SILMER_WAP_CONTROL_RUNTIME_EOF' /evolution/wap-control-runtime.cjs
'use strict';

// WAP-E02: fixed private adapter in the existing Evolution process. No queue,
// disk, log, retry, instance deletion, inbound revision or generic proxy route.
const { timingSafeEqual } = require('node:crypto');
const PATH = '/silmer/whatsapp-control/execute';
const ID = /^[A-Za-z0-9_-]{1,64}$/;
const UUID =
  /^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/i;

function denied() {
  throw new Error('WAP_CONTROL_DENIED');
}
function exact(value, fields) {
  if (
    !value ||
    typeof value !== 'object' ||
    Array.isArray(value) ||
    Object.keys(value).sort().join(',') !== [...fields].sort().join(',')
  )
    denied();
}
function equal(left, right) {
  const a = Buffer.from(typeof left === 'string' ? left : '');
  const b = Buffer.from(typeof right === 'string' ? right : '');
  return a.length > 0 && a.length === b.length && timingSafeEqual(a, b);
}
// WAP-E12: lifecycle plus inbound/echo (upsert) and receipts (update).
// Challenge budget: Evolution's own connect waits 2 s, then up to 8 s of
// polling at 500 ms; the CRM client aborts the whole n8n chain at 15 s.
const CHALLENGE_WAIT_MS = 8000;
const CHALLENGE_POLL_MS = 500;
const WEBHOOK_EVENTS = Object.freeze([
  'CONNECTION_UPDATE',
  'MESSAGES_UPSERT',
  'MESSAGES_UPDATE',
]);
function verifiedWebhook(webhook, expectedUrl) {
  return (
    webhook?.enabled === true &&
    webhook.url === expectedUrl &&
    webhook.webhookByEvents === false &&
    webhook.webhookBase64 === false &&
    Array.isArray(webhook.events) &&
    webhook.events.length === WEBHOOK_EVENTS.length &&
    new Set(webhook.events).size === WEBHOOK_EVENTS.length &&
    WEBHOOK_EVENTS.every((event) => webhook.events.includes(event))
  );
}
// WAP-E12: Evolution 2.3.7 SettingsDto (POST /settings/set/:name, schema
// requires the six booleans). Applied on every connect, not only at create:
// a reused instance keeps whatever it had. Empty msgCall/wavoipToken clear an
// automatic call reply and the wavoip socket, both outbound traffic.
const SETTINGS = Object.freeze({
  rejectCall: false,
  msgCall: '',
  groupsIgnore: true,
  alwaysOnline: false,
  readMessages: false,
  readStatus: false,
  syncFullHistory: false,
  wavoipToken: '',
});
// GET /settings/find/:name returns the stored row flat, or null when absent.
function verifiedSettings(settings) {
  return (
    settings !== null &&
    typeof settings === 'object' &&
    !Array.isArray(settings) &&
    Object.entries(SETTINGS).every(([field, expected]) =>
      typeof expected === 'boolean'
        ? settings[field] === expected
        : (settings[field] ?? '') === '',
    )
  );
}
// Evolution can retain an unpaired row across a restart without loading its
// socket. Its state reply then contains only the instance name.
function unpairedWithoutSocket(row, observation) {
  const instance = observation?.instance;
  return (
    row &&
    !row.ownerJid &&
    ['close', 'connecting'].includes(row.connectionStatus) &&
    instance?.instanceName === row.name &&
    !('state' in instance)
  );
}

function configuration(env) {
  const enabled = env.SILMER_WAP_CONTROL_ENABLED === 'true';
  if (
    env.SILMER_WAP_CONTROL_ENABLED !== undefined &&
    !['true', 'false'].includes(env.SILMER_WAP_CONTROL_ENABLED)
  )
    denied();
  if (!enabled) return { enabled: false, instances: [] };
  const instances = (env.SILMER_WAP_GENERATION_INSTANCES || '').split(',');
  let webhook;
  try {
    webhook = new URL(env.SILMER_WAP_CONTROL_WEBHOOK_URL);
  } catch {
    denied();
  }
  if (
    env.SILMER_WAP_GENERATION_ENABLED !== 'true' ||
    !instances.length ||
    instances.some((v) => !ID.test(v)) ||
    new Set(instances).size !== instances.length ||
    !env.AUTHENTICATION_API_KEY ||
    env.AUTHENTICATION_API_KEY.length < 32 ||
    webhook.protocol !== 'https:' ||
    webhook.username ||
    webhook.password ||
    webhook.search ||
    webhook.hash ||
    !webhook.pathname.startsWith('/webhook/silmer/seller-whatsapp/')
  )
    denied();
  const port = Number(env.SERVER_PORT || '8080');
  if (!Number.isSafeInteger(port) || port < 1 || port > 65535) denied();
  return {
    enabled: true,
    instances,
    webhook: webhook.href,
    origin: `http://127.0.0.1:${port}`,
    key: env.AUTHENTICATION_API_KEY,
  };
}

async function jsonBytes(response, limit = 1024 * 1024) {
  if (!response.body) throw new Error('WAP_CONTROL_UNKNOWN');
  const reader = response.body.getReader();
  const chunks = [];
  let bytes = 0;
  try {
    for (;;) {
      const { done, value } = await reader.read();
      if (done) break;
      bytes += value.length;
      if (bytes > limit) {
        await reader.cancel();
        throw new Error();
      }
      chunks.push(Buffer.from(value));
    }
    return JSON.parse(Buffer.concat(chunks).toString());
  } catch {
    throw new Error('WAP_CONTROL_UNKNOWN');
  } finally {
    reader.releaseLock();
  }
}

function createControlAdapter({
  env = process.env,
  generationRuntime,
  fetchImpl = globalThis.fetch,
  clock = () => new Date(),
  sleep = (ms) => new Promise((resolve) => setTimeout(resolve, ms)),
} = {}) {
  const config = configuration(env);
  // Serializes only in-process calls. The authoritative one-shot reservation is
  // the CRM ledger; this guard is not presented as durable idempotency.
  const inFlight = new Set();
  async function http(path, method = 'GET', body) {
    const response = await fetchImpl(new URL(path, config.origin), {
      method,
      redirect: 'error',
      cache: 'no-store',
      signal: AbortSignal.timeout(10000),
      headers: {
        apikey: config.key,
        'content-type': 'application/json',
        'cache-control': 'no-store',
      },
      ...(body === undefined ? {} : { body: JSON.stringify(body) }),
    });
    if (![200, 201].includes(response.status))
      throw new Error('WAP_CONTROL_UNKNOWN');
    const value = await jsonBytes(response);
    if (value?.error === true) throw new Error('WAP_CONTROL_UNKNOWN');
    return value;
  }
  return Object.freeze({
    enabled: config.enabled,
    async execute(body) {
      if (!config.enabled) denied();
      exact(body, [
        'kind',
        'instance',
        'expectedNumber',
        'webhookUrl',
        'source',
        'generationToken',
        ...(body?.kind === 'challenge' ? ['challenge'] : ['action']),
      ]);
      if (
        !['control', 'challenge'].includes(body.kind) ||
        !config.instances.includes(body.instance) ||
        !/^\+?[1-9][0-9]{7,14}$/.test(body.expectedNumber) ||
        body.webhookUrl !== config.webhook
      )
        denied();
      if (
        body.kind === 'challenge' ||
        body.action === 'connect' ||
        (body.action === 'reconcile' && body.source !== null)
      ) {
        if (
          typeof body.generationToken !== 'string' ||
          !/^[A-Za-z0-9_-]{32,128}$/.test(body.generationToken)
        )
          denied();
        exact(body.source, ['bindingId', 'lineId', 'accountId', 'generation']);
        if (
          !['bindingId', 'lineId', 'accountId'].every(
            (k) =>
              typeof body.source[k] === 'string' && ID.test(body.source[k]),
          ) ||
          !Number.isSafeInteger(body.source.generation) ||
          body.source.generation < 1
        )
          denied();
      } else if (body.source !== null || body.generationToken !== null)
        denied();
      if (
        body.kind === 'control' &&
        !['connect', 'disconnect', 'reconcile'].includes(body.action)
      )
        denied();
      if (body.kind === 'challenge') {
        exact(body.challenge, [
          'challengeId',
          'operationId',
          'mode',
          'expiresAt',
        ]);
        if (
          !UUID.test(body.challenge.challengeId) ||
          !UUID.test(body.challenge.operationId) ||
          !['qr', 'code'].includes(body.challenge.mode) ||
          !Number.isFinite(Date.parse(body.challenge.expiresAt)) ||
          Date.parse(body.challenge.expiresAt) <= clock().getTime() ||
          Date.parse(body.challenge.expiresAt) > clock().getTime() + 120000
        )
          denied();
      }
      if (inFlight.has(body.instance)) denied();
      inFlight.add(body.instance);
      const name = encodeURIComponent(body.instance);
      try {
        if (body.kind === 'challenge') {
          // Reusing the exact binding is a no-op; never reclassify the socket.
          generationRuntime.ensureBinding(
            body.instance,
            body.source,
            body.generationToken,
          );
          const suffix =
            body.challenge.mode === 'code'
              ? `?number=${encodeURIComponent(body.expectedNumber.replace(/^\+/, ''))}`
              : '';
          const read = (/** @type {any} */ result) =>
            body.challenge.mode === 'code'
              ? result?.pairingCode
              : result?.base64;
          // Evolution 2.3.7 starts the socket on a 'close' instance, waits a
          // fixed 2 s and returns whatever QR exists; the QR (and the pairing
          // code) is rendered asynchronously and may still be missing. While
          // the instance is 'connecting', connect only reads the current QR
          // (no second socket), so poll it within a bound the CRM can await.
          let value = read(await http(`/instance/connect/${name}${suffix}`));
          const deadline = clock().getTime() + CHALLENGE_WAIT_MS;
          while (typeof value !== 'string' && clock().getTime() < deadline) {
            await sleep(CHALLENGE_POLL_MS);
            const state = await http(`/instance/connectionState/${name}`);
            if (state?.instance?.state !== 'connecting') break;
            value = read(await http(`/instance/connect/${name}${suffix}`));
          }
          if (
            typeof value !== 'string' ||
            (body.challenge.mode === 'code'
              ? !/^[A-Za-z0-9-]{8,32}$/.test(value)
              : !/^data:image\/png;base64,[A-Za-z0-9+/]+=*$/.test(value))
          )
            throw new Error('WAP_CONTROL_UNKNOWN');
          return {
            ...body.challenge,
            generation: body.source.generation,
            value,
          };
        }
        if (body.action === 'connect') {
          // Read first: a reconnect preserves the opaque account/instance. It
          // never creates a second instance because a prior response was lost.
          const all = await http('/instance/fetchInstances');
          if (!Array.isArray(all)) throw new Error('WAP_CONTROL_UNKNOWN');
          const own = all.filter((v) => v.name === body.instance);
          if (own.length > 1) throw new Error('WAP_CONTROL_UNKNOWN');
          const existing = own[0];
          if (
            existing &&
            existing.connectionStatus !== 'close' &&
            (existing.connectionStatus !== 'connecting' ||
              existing.ownerJid ||
              !unpairedWithoutSocket(
                existing,
                await http(`/instance/connectionState/${name}`),
              ))
          )
            throw new Error('WAP_CONTROL_UNKNOWN');
          if (!existing) {
            const created = await http('/instance/create', 'POST', {
              instanceName: body.instance,
              integration: 'WHATSAPP-BAILEYS',
              qrcode: false,
              // Evolution 2.3.7 InstanceDto settings: no group traffic, no
              // read receipts sent on the seller's behalf, no history import.
              groupsIgnore: true,
              readMessages: false,
              readStatus: false,
              syncFullHistory: false,
              alwaysOnline: false,
              rejectCall: false,
            });
            if (created?.instance?.instanceName !== body.instance)
              throw new Error('WAP_CONTROL_UNKNOWN');
          }
          // Settings are proven before the webhook can carry any event.
          await http(`/settings/set/${name}`, 'POST', { ...SETTINGS });
          if (!verifiedSettings(await http(`/settings/find/${name}`)))
            throw new Error('WAP_CONTROL_UNKNOWN');
          await http(`/webhook/set/${name}`, 'POST', {
            webhook: {
              enabled: true,
              url: config.webhook,
              byEvents: false,
              base64: false,
              events: [...WEBHOOK_EVENTS],
            },
          });
          const observedWebhook = await http(`/webhook/find/${name}`);
          const observedState = await http(`/instance/connectionState/${name}`);
          if (
            !verifiedWebhook(observedWebhook, config.webhook) ||
            (observedState?.instance?.state !== 'close' &&
              !unpairedWithoutSocket(existing, observedState))
          )
            throw new Error('WAP_CONTROL_UNKNOWN');
          return {
            outcome: 'succeeded',
            providerState: 'close',
            webhookVerified: true,
            bindingVerified: false,
          };
        }
        if (body.action === 'disconnect') {
          await http(`/instance/logout/${name}`, 'DELETE');
          return {
            outcome: 'succeeded',
            providerState: 'close',
            webhookVerified: false,
            bindingVerified: false,
          };
        }
        // Reconciliation consists only of reads; no connect, logout or delete.
        const observed = await http('/instance/fetchInstances');
        if (!Array.isArray(observed)) throw new Error('WAP_CONTROL_UNKNOWN');
        const own = observed.filter(
          (candidate) => candidate.name === body.instance,
        );
        if (!own.length)
          return {
            outcome: 'reconciled',
            providerState: 'absent',
            webhookVerified: false,
            bindingVerified: false,
          };
        if (own.length !== 1) throw new Error('WAP_CONTROL_UNKNOWN');
        const state = await http(`/instance/connectionState/${name}`);
        const webhook = await http(`/webhook/find/${name}`);
        const settings = await http(`/settings/find/${name}`);
        const providerState = unpairedWithoutSocket(own[0], state)
          ? 'close'
          : state?.instance?.state;
        if (!['open', 'close', 'connecting'].includes(providerState))
          throw new Error('WAP_CONTROL_UNKNOWN');
        // WAP-E12: the CRM contract has one routing proof; drifted settings
        // withhold it exactly like a drifted webhook (reconcile -> blocked).
        const webhookVerified =
          verifiedWebhook(webhook, config.webhook) &&
          verifiedSettings(settings);
        const jid = /^([1-9][0-9]{7,14})@s\.whatsapp\.net$/.exec(
          own[0].ownerJid || '',
        );
        return {
          outcome: 'reconciled',
          providerState,
          webhookVerified,
          bindingVerified:
            body.source !== null &&
            generationRuntime.bindingMatchesSocket(
              body.instance,
              body.source,
              body.generationToken,
            ),
          ...(providerState === 'open' && jid
            ? { confirmedNumber: `+${jid[1]}` }
            : {}),
        };
      } finally {
        inFlight.delete(body.instance);
      }
    },
  });
}

// The middleware runs before the upstream parsers and routes. Only this exact
// path is consumed. Native routes/authentication are otherwise untouched.
function createControlMiddleware(options = {}) {
  const env = options.env || process.env;
  const adapter = createControlAdapter(options);
  return async (req, res, next) => {
    if ((req.url || '').split('?')[0] !== PATH) return next();
    res.setHeader('Cache-Control', 'no-store');
    res.setHeader('Content-Type', 'application/json');
    try {
      if (
        !adapter.enabled ||
        req.url !== PATH ||
        req.method !== 'POST' ||
        !equal(req.headers?.apikey, env.AUTHENTICATION_API_KEY) ||
        req.headers?.['content-type']?.split(';')[0] !== 'application/json'
      )
        denied();
      let length = 0;
      const chunks = [];
      for await (const chunk of req) {
        length += chunk.length;
        if (length > 8192) denied();
        chunks.push(Buffer.from(chunk));
      }
      const result = await adapter.execute(
        JSON.parse(Buffer.concat(chunks).toString()),
      );
      res.statusCode = 200;
      res.end(JSON.stringify(result));
    } catch (error) {
      res.statusCode = error?.message === 'WAP_CONTROL_DENIED' ? 403 : 503;
      res.end(
        res.statusCode === 403
          ? '{"code":"WAP_CONTROL_DENIED"}'
          : '{"code":"WAP_CONTROL_UNKNOWN"}',
      );
    }
  };
}

function protectExpress(express, options = {}) {
  if (typeof express !== 'function') denied();
  return new Proxy(express, {
    apply(target, receiver, args) {
      const app = Reflect.apply(target, receiver, args);
      app.use(createControlMiddleware(options));
      return app;
    },
  });
}

module.exports = {
  createControlAdapter,
  createControlMiddleware,
  protectExpress,
  configuration,
  PATH,
};

SILMER_WAP_CONTROL_RUNTIME_EOF
COPY <<'SILMER_WAP_GENERATION_PATCH_EOF' /evolution/silmer-wap-generation-patch.mjs
import { createHash } from 'node:crypto';
import { readFile, writeFile } from 'node:fs/promises';
import { pathToFileURL } from 'node:url';

export const EVOLUTION_BUNDLE_SHA256 =
  '71b49ea87b8d0d7b413b77d067e33a8720c2e95e136f632210c1424862ef6b44';
export const WAP_GENERATION_RUNTIME_PATH =
  '/evolution/silmer-wap-generation.cjs';
const METHOD_START =
  'async emit({instanceName:e,origin:t,event:o,data:i,serverUrl:n,dateTime:r,sender:a,apiKey:c,local:l,integration:u,extra:m}){';
const BODY =
  'C={...m??{},event:o,instance:e,data:i,destination:d?.url||`${h.GLOBAL.URL}/${w}`,date_time:r,sender:a,server_url:n,apikey:c};';
// Complete Prisma writeData function extracted from the pinned bundle. Other
// file/Redis adapters are intentionally outside this fixed PostgreSQL profile.
export const PRISMA_CREDENTIAL_WRITER =
  'async function o(c,l){let u=JSON.stringify(c,st.BufferJSON.replacer),m=E.get("CACHE");if(l!="creds"){if(m.REDIS.ENABLED)return await s.hSet(p,l,c);await vt.default.writeFile(t(l),u);return}await cu(p,u)}';

/** @returns {string} */
export function patchedPrismaCredentialWriter() {
  return PRISMA_CREDENTIAL_WRITER.replace(
    'JSON.stringify(c,st.BufferJSON.replacer)',
    `JSON.stringify(l==="creds"?require(${JSON.stringify(WAP_GENERATION_RUNTIME_PATH)}).persistableCredentials(c):c,st.BufferJSON.replacer)`,
  );
}

/** @param {string} bundle @returns {string} */
export function patchEvolutionGeneration(bundle) {
  if (
    createHash('sha256').update(bundle).digest('hex') !==
    EVOLUTION_BUNDLE_SHA256
  )
    throw new Error('WAP_EVOLUTION_BUNDLE_MISMATCH');
  const runtime = `require(${JSON.stringify(WAP_GENERATION_RUNTIME_PATH)})`;
  const replacements = [
    [PRISMA_CREDENTIAL_WRITER, patchedPrismaCredentialWriter()],
    [
      'eventHandler(){this.client.ev.process(async e=>{',
      `eventHandler(){const silmerWapRuntime=${runtime},silmerWapSource=silmerWapRuntime.captureSocket(this.instanceName,this.client);const silmerWapProcess=cb=>this.client.ev.process(silmerWapRuntime.wrap(silmerWapSource,cb));silmerWapProcess(async e=>{`,
    ],
    [
      `${METHOD_START}if(u&&!u.includes("webhook"))return;`,
      `${METHOD_START}const silmerWapRuntime=${runtime};let silmerWapSource;try{silmerWapSource=silmerWapRuntime.current(e,o)}catch{this.logger.warn("WAP_GENERATION_EVENT_REJECTED");return;}if(u&&!u.includes("webhook"))return;`,
    ],
    [
      'g=d?.events,f={...d?.headers||{}};',
      'g=d?.events,f=silmerWapRuntime.headers(silmerWapSource,{...d?.headers||{}});',
    ],
    [
      BODY,
      `C;try{C=silmerWapRuntime.envelope(silmerWapSource,${BODY.slice(2, -1)});}catch{this.logger.warn("WAP_GENERATION_EVENT_REJECTED");return;}`,
    ],
  ];
  let patched = bundle;
  for (const [before, after] of replacements) {
    if (patched.split(before).length !== 2)
      throw new Error('WAP_EVOLUTION_ANCHOR_MISMATCH');
    patched = patched.replace(before, after);
  }
  return patched;
}

/** Extract complete real methods from the exact patched bundle for synthetic event
 * rehearsal. No server startup or WhatsApp protocol is evaluated.
 * @param {string} patched @returns {Record<string,string>}
 */
export function extractGenerationMethods(patched) {
  /** @type {Record<string,string>} */
  const snippets = {};
  for (const [name, start, end] of [
    [
      'eventHandler',
      'eventHandler(){const silmerWapRuntime=',
      'historySyncNotification(e){',
    ],
    [
      'connectionUpdate',
      'async connectionUpdate({qr:e,connection:t,lastDisconnect:o}){',
      'async getMessage(e,t=!1){',
    ],
    [
      'sendDataWebhook',
      'async sendDataWebhook(s,e,t=!0,o,i){',
      'formatMXOrARNumber(s){',
    ],
    [
      'emit',
      `${METHOD_START}const silmerWapRuntime=`,
      'async retryWebhookRequest(e,t,o,i,n,r,a){',
    ],
    [
      'retryWebhookRequest',
      'async retryWebhookRequest(e,t,o,i,n,r,a){',
      'generateJwtToken(e){',
    ],
  ]) {
    const begin = patched.indexOf(start);
    const finish = patched.indexOf(end, begin);
    if (begin < 0 || finish <= begin || patched.indexOf(start, begin + 1) >= 0)
      throw new Error('WAP_EVOLUTION_EXTRACTION_MISMATCH');
    snippets[name] = patched.slice(begin, finish);
  }
  return snippets;
}

/** @param {string} patched @returns {string} */
export function extractPrismaCredentialWriter(patched) {
  const method = patchedPrismaCredentialWriter();
  if (patched.split(method).length !== 2)
    throw new Error('WAP_EVOLUTION_CREDENTIAL_WRITER_MISMATCH');
  return method;
}

if (
  process.argv[1] &&
  import.meta.url === pathToFileURL(process.argv[1]).href
) {
  const filename = process.argv[2];
  if (!filename) throw new Error('WAP_EVOLUTION_BUNDLE_PATH_REQUIRED');
  const patched = patchEvolutionGeneration(await readFile(filename, 'utf8'));
  extractGenerationMethods(patched);
  extractPrismaCredentialWriter(patched);
  await writeFile(filename, patched);
  process.stdout.write('WAP_EVOLUTION_GENERATION_PATCHED\n');
}

SILMER_WAP_GENERATION_PATCH_EOF
RUN node /evolution/silmer-wap-generation-patch.mjs /evolution/dist/main.js
RUN mkdir -p /evolution/instances /evolution/store && chown -R node:node /evolution/instances /evolution/store /evolution/prisma /evolution/node_modules/.prisma
USER node
EXPOSE 8080
# Upstream migration script prints DATABASE_URL; discard all raw migration output.
# Runtime protection is loaded only in the API, never in npm/Prisma subprocesses.
ENTRYPOINT ["/bin/bash", "-c", "set -eu; node /evolution/silmer-privacy.cjs --check; if /bin/bash ./Docker/scripts/deploy_database.sh >/dev/null 2>&1; then printf 'EVOLUTION_DATABASE_READY\n'; else printf 'EVOLUTION_DATABASE_FAILED\n' >&2; exit 1; fi; node /evolution/silmer-retention.cjs --once; exec node --require /evolution/silmer-privacy.cjs dist/main"]
