{
  "name": "crm-silmer",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.9.0",
  "engines": {
    "node": "24.14.0",
    "npm": "11.9.0"
  },
  "workspaces": [
    "apps/*",
    "modules/*"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "format": "prettier --write package.json \"apps/**/*.{html,css,js,json}\" \"modules/**/*.{js,json}\" \"docs/phase0/**/*.{json,md}\" \"ops/**/*.{json,md}\" \"schemas/**/*.json\" \"scripts/**/*.mjs\" \"test/**/*.js\" \".github/workflows/*.yml\" eslint.config.js jsconfig.json playwright.config.js .prettierrc.json",
    "format:check": "prettier --check package.json \"apps/**/*.{html,css,js,json}\" \"modules/**/*.{js,json}\" \"docs/phase0/**/*.{json,md}\" \"ops/**/*.{json,md}\" \"schemas/**/*.json\" \"scripts/**/*.mjs\" \"test/**/*.js\" \".github/workflows/*.yml\" eslint.config.js jsconfig.json playwright.config.js .prettierrc.json",
    "lint": "eslint apps modules scripts test eslint.config.js",
    "preview": "node scripts/serve-edge.mjs",
    "recovery:plan": "node scripts/recovery-mock.mjs --plan",
    "test": "node --test test/*.test.js",
    "test:recovery:mocks": "node --test test/topology-recovery.test.js",
    "test:external-spikes": "node --test test/external-spikes.test.js",
    "test:phase0-decisions": "node --test test/phase0-decisions.test.js",
    "test:security-catalog": "node --test test/security-catalog.test.js",
    "test:e2e": "playwright test",
    "typecheck": "tsc --project jsconfig.json",
    "validate:topology": "node scripts/validate-topology.mjs && node scripts/recovery-mock.mjs --check",
    "validate:external-spikes": "node scripts/validate-external-spikes.mjs",
    "validate:phase0-decisions": "node scripts/validate-phase0-decisions.mjs",
    "validate:security-catalog": "node scripts/validate-security-catalog.mjs",
    "validate": "npm run format:check && npm run typecheck && npm run lint && npm run check:boundaries && npm run validate:topology && npm run validate:external-spikes && npm run validate:security-catalog && npm run validate:phase0-decisions && npm test && npm run build"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.62.1",
    "@types/node": "24.13.3",
    "@types/punycode": "2.1.4",
    "eslint": "10.9.1",
    "prettier": "3.9.6",
    "typescript": "7.0.2"
  }
}
