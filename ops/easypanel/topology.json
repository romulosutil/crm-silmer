      },
      "services": [
        {
          "name": "silmer-edge-web",
          "kind": "app",
          "image": "edge-web",
          "imageRef": "ghcr.io/romulosutil/crm-silmer/edge-web@sha256:dd9fde3ab72cd22df7d89be57a508e73e7e97461c0efb3b97cbf7bb91f7f9187",
          "public": true,
          "publicPorts": [80, 443],
          "persistence": "none",
          "limits": { "cpu": 0.25, "memoryMb": 256 },
          "health": {
            "intervalSeconds": 30,
            "timeoutSeconds": 5,
            "startPeriodSeconds": 20,
            "failureThreshold": 3,
            "checks": [{ "type": "http", "endpoint": "/healthz" }]
          }
        },
        {
          "name": "silmer-api",
          "kind": "app",
          "image": "runtime",
          "imageRef": "ghcr.io/romulosutil/crm-silmer/runtime@sha256:3c29961a1a8d0271956439f4ae6891a8ec3181494224b3d063c56c6b95fd5661",
          "public": false,
          "publicPorts": [],
          "persistence": "none",
          "limits": { "cpu": 1, "memoryMb": 1536 },
          "health": {
            "intervalSeconds": 30,
            "timeoutSeconds": 5,
            "startPeriodSeconds": 20,
            "failureThreshold": 3,
            "checks": [
              { "type": "http", "endpoint": "/api/health/live" },
              { "type": "http", "endpoint": "/api/health/ready" }
            ]
          }
        },
        {
          "name": "silmer-worker",
          "kind": "app",
          "image": "runtime",
          "imageRef": "ghcr.io/romulosutil/crm-silmer/runtime@sha256:3c29961a1a8d0271956439f4ae6891a8ec3181494224b3d063c56c6b95fd5661",
          "public": false,
          "publicPorts": [],
          "persistence": "temporary-limited",
          "limits": { "cpu": 1.5, "memoryMb": 2048 },
          "health": {
            "intervalSeconds": 30,
            "timeoutSeconds": 5,
            "startPeriodSeconds": 20,
            "failureThreshold": 3,
            "checks": [
              { "type": "process-loop", "externalDependencies": false },
              { "type": "postgres-heartbeat", "maxAgeSeconds": 120 }
            ]
          }
        },
        {
          "name": "silmer-postgres",
          "kind": "postgresql",
          "major": 17,
          "public": false,
          "publicPorts": [],
          "persistence": "easypanel-volume-plus-external-backup",
          "limits": { "cpu": 2, "memoryMb": 5120 },
          "health": {
            "intervalSeconds": 30,
            "timeoutSeconds": 5,
            "startPeriodSeconds": 20,
            "failureThreshold": 3,
            "checks": [{ "type": "command", "command": "pg_isready" }]
          }
        }
      ]
    }
