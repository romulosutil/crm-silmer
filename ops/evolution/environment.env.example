# EVOL-01. Fill secrets only in EasyPanel; never commit the populated file.
SERVER_NAME=silmer-evolution
SERVER_TYPE=http
SERVER_PORT=8080
SERVER_URL=http://schedule_silmer-evolution:8080
DOCKER_ENV=true
TZ=UTC
DATABASE_PROVIDER=postgresql
DATABASE_CONNECTION_URI=postgresql://silmer_evolution:REPLACE_DATABASE_PASSWORD@schedule_silmer-evolution-db:5432/silmer_evolution?schema=public
DATABASE_CONNECTION_CLIENT_NAME=silmer_evolution
DATABASE_SAVE_DATA_INSTANCE=true
DATABASE_SAVE_DATA_NEW_MESSAGE=true
DATABASE_SAVE_MESSAGE_UPDATE=false
DATABASE_SAVE_DATA_CONTACTS=false
DATABASE_SAVE_DATA_CHATS=false
DATABASE_SAVE_DATA_LABELS=false
DATABASE_SAVE_DATA_HISTORIC=false
DATABASE_SAVE_IS_ON_WHATSAPP=false
DATABASE_DELETE_MESSAGE=true
CACHE_REDIS_ENABLED=false
CACHE_REDIS_SAVE_INSTANCES=false
CACHE_LOCAL_ENABLED=true
CACHE_REDIS_TTL=86400
TELEMETRY_ENABLED=false
SENTRY_DSN=
PROMETHEUS_METRICS=false
AUTHENTICATION_API_KEY=REPLACE_WITH_DISTINCT_RANDOM_SECRET_32_CHARS_MINIMUM
AUTHENTICATION_EXPOSE_IN_FETCH_INSTANCES=false
SILMER_EVOLUTION_WEBHOOK_URL=https://schedule-n8n.jicnzg.easypanel.host/webhook/silmer/evolution-events
SILMER_EVOLUTION_WEBHOOK_TOKEN=REPLACE_WITH_DISTINCT_RANDOM_SECRET_32_CHARS_MINIMUM
SILMER_EVOLUTION_RUNTIME=true
SILMER_EVOLUTION_INSTANCE=silmer
WEBHOOK_GLOBAL_ENABLED=false
WEBHOOK_GLOBAL_URL=
WEBHOOK_EVENTS_ERRORS=false
WEBHOOK_REQUEST_TIMEOUT_MS=30000
WEBHOOK_RETRY_MAX_ATTEMPTS=3
WEBHOOK_RETRY_INITIAL_DELAY_SECONDS=5
WEBHOOK_RETRY_USE_EXPONENTIAL_BACKOFF=true
WEBHOOK_RETRY_MAX_DELAY_SECONDS=10
WEBHOOK_RETRY_JITTER_FACTOR=0.2
WEBHOOK_RETRY_NON_RETRYABLE_STATUS_CODES=400,401,403,404,409,413,415,422
WEBSOCKET_ENABLED=false
WEBSOCKET_GLOBAL_EVENTS=false
RABBITMQ_ENABLED=false
SQS_ENABLED=false
PUSHER_ENABLED=false
KAFKA_ENABLED=false
S3_ENABLED=false
TYPEBOT_ENABLED=false
CHATWOOT_ENABLED=false
OPENAI_ENABLED=false
DIFY_ENABLED=false
N8N_ENABLED=false
EVOAI_ENABLED=false
FLOWISE_ENABLED=false
LOG_LEVEL=ERROR
LOG_BAILEYS=fatal
LOG_COLOR=false
CORS_ORIGIN=*
CORS_CREDENTIALS=false
DEL_INSTANCE=false
DEL_TEMP_INSTANCES=false
CONFIG_SESSION_PHONE_CLIENT=Silmer Inbox
CONFIG_SESSION_PHONE_NAME=Chrome
QRCODE_LIMIT=5
LANGUAGE=pt-BR
